# Copy to .env.local and fill in. For Vercel, add these in Project Settings → Environment Variables.

# LLM (use at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# UploadThing
UPLOADTHING_TOKEN=

# Airtable
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=resumes

# Resend
RESEND_API_KEY=
EMAIL_FROM=

# App (use your production URL, e.g. https://resroa.com)
NEXT_PUBLIC_APP_URL=
